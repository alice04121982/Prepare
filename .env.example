# Copy to .env.local for local work. Never commit real values.

# Amazon Associates tracking ID (public, shown in every link).
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=stayprepared2-21

# Amazon Product Advertising API keys: live prices and photos on /checklist.
# Issued once the Associates account has 3 qualifying sales in 180 days.
# Server only: never prefix these with NEXT_PUBLIC_. Leave empty to keep the
# API off; the site then shows product names and links only.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
