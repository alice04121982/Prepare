{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "concepts",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');const d='/Users/alicesmith/Documents/prepare-website/.impeccable/mocks/concepts';h.createServer((q,r)=>{const u=decodeURIComponent(q.url.split('?')[0]);const x=p.join(d,u==='/'?'index.html':u);if(!x.startsWith(d)){r.writeHead(403);return r.end();}f.readFile(x,(e,b)=>{if(e){r.writeHead(404);return r.end();}r.writeHead(200,{'content-type':x.endsWith('.html')?'text/html; charset=utf-8':'text/plain'});r.end(b);});}).listen(4173)"],
      "port": 4173
    },
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    }
  ]
}
